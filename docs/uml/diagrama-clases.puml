@startuml ArenaGT_UML
title ArenaGT - Diagrama de clases

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 45
hide empty members

' ============================================================
' Modelo
' ============================================================
package "arena.modelo" {
  class Empresa {
    - nombre : String
    + Empresa(nombre : String)
    + getNombre() : String
    + equals(Object) : boolean
    + hashCode() : int
  }

  class Participante {
    - codigo : String
    - nombre : String
    - empresa : Empresa
    + Participante(codigo : String, nombre : String, empresa : Empresa)
    + getCodigo() : String
    + getNombre() : String
    + getEmpresa() : Empresa
    + equals(Object) : boolean
  }

  interface Resultado {
    + participantes() : Collection<Participante>
    + puntos(p : Participante) : int
    + diferencia(p : Participante) : int
    + victoria(p : Participante) : boolean
    + descripcion() : String
  }

  class ResultadoEncuentro {
    - local : Participante
    - visitante : Participante
    - puntosLocal : int
    - puntosVisitante : int
    - diferenciaLocal : int
    - diferenciaVisitante : int
    - victoriaLocal : boolean
    - victoriaVisitante : boolean
    - descripcion : String
    + ResultadoEncuentro(...)
    + puntos(p : Participante) : int
    + diferencia(p : Participante) : int
    + victoria(p : Participante) : boolean
  }

  class ResultadoCarrera {
    - estadisticas : Map<Participante, Estadistica>
    - descripcion : String
    + ResultadoCarrera(estadisticas, descripcion)
    + puntos(p : Participante) : int
    + diferencia(p : Participante) : int
    + victoria(p : Participante) : boolean
  }

  class FilaTabla <<Comparable>> {
    - participante : Participante
    - puntos : int
    - diferencia : int
    - victorias : int
    + compareTo(otra : FilaTabla) : int
  }

  class FilaRanking <<Comparable>> {
    - empresa : Empresa
    - puntos : int
    + compareTo(otra : FilaRanking) : int
  }

  enum EstadoTorneo {
    EN_INSCRIPCION
    EN_JUEGO
    FINALIZADO
  }

  enum EstadoEvento {
    SIN_PROGRAMAR
    PROGRAMADO
    FINALIZADO
  }

  interface Entrada {
    + leerTexto(mensaje : String) : String
    + leerEntero(mensaje : String) : int
    + leerDecimal(mensaje : String) : double
  }

  class ReglaNegocioException {
    + ReglaNegocioException(mensaje : String)
  }
}

' ============================================================
' Disciplinas
' ============================================================
package "arena.disciplinas" {
  abstract class Disciplina {
    - nombre : String
    - minParticipantes : int
    - maxParticipantes : int
    - cuota : double
    + {abstract} generarEventos(torneo : Torneo) : List<Evento>
    + getNombre() : String
    + getMinParticipantes() : int
    + getMaxParticipantes() : int
    + getCuota() : double
    + calcularPremio(inscritos : int) : double
  }

  abstract class DisciplinaEncuentro {
    + generarEventos(torneo : Torneo) : List<Evento>
    + {abstract} leerResultado(e : Encuentro, entrada : Entrada) : Resultado
  }

  abstract class DisciplinaCarrera {
    + generarEventos(torneo : Torneo) : List<Evento>
    + {abstract} leerResultado(c : Carrera, entrada : Entrada) : Resultado
  }

  class FutbolSala {
    + FutbolSala()
    + leerResultado(e : Encuentro, entrada : Entrada) : Resultado
    # construirResultado(...) : Resultado
  }

  class FutbolSalaPenales {
    + FutbolSalaPenales()
    + leerResultado(e : Encuentro, entrada : Entrada) : Resultado
  }

  class Baloncesto {
    + Baloncesto()
    + leerResultado(e : Encuentro, entrada : Entrada) : Resultado
  }

  class Voleibol {
    + Voleibol()
    + leerResultado(e : Encuentro, entrada : Entrada) : Resultado
  }

  class Relevos {
    + Relevos()
    + leerResultado(c : Carrera, entrada : Entrada) : Resultado
  }
}

' ============================================================
' Eventos
' ============================================================
package "arena.eventos" {
  abstract class Evento <<Comparable>> {
    - codigo : String
    - torneo : Torneo
    - participantes : List<Participante>
    - fecha : LocalDate
    - hora : int
    - sede : String
    - estado : EstadoEvento
    - resultado : Resultado
    + {abstract} getTipoEvento() : String
    + {abstract} getDescripcion() : String
    + {abstract} leerResultado(entrada : Entrada) : Resultado
    + aplicarProgramacion(fecha, hora, sede) : void
    + registrarResultado(r : Resultado) : void
    + puntosDe(p : Participante) : int
    + diferenciaDe(p : Participante) : int
    + victoriaDe(p : Participante) : boolean
    + compareTo(otro : Evento) : int
  }

  class Encuentro {
    - disciplina : DisciplinaEncuentro
    - local : Participante
    - visitante : Participante
    + Encuentro(codigo, torneo, disciplina, local, visitante)
    + leerResultado(entrada : Entrada) : Resultado
    + getLocal() : Participante
    + getVisitante() : Participante
  }

  class Carrera {
    - disciplina : DisciplinaCarrera
    + Carrera(codigo, torneo, disciplina, participantes)
    + leerResultado(entrada : Entrada) : Resultado
  }

  class Calendario <<Iterable<Evento>>> {
    - eventos : List<Evento>
    + Calendario(eventos : Collection<Evento>)
    + iterator() : Iterator<Evento>
  }
}

' ============================================================
' Torneos y contabilidad
' ============================================================
package "arena.torneo" {
  class Torneo {
    - codigo : String
    - nombre : String
    - disciplina : Disciplina
    - estado : EstadoTorneo
    - participantes : List<Participante>
    - eventos : List<Evento>
    + Torneo(codigo, nombre, disciplina)
    + inscribir(p : Participante) : void
    + cerrarInscripciones() : void
    + verificarFinalizacion() : boolean
    + getTablaPosiciones() : TablaPosiciones
    + getCampeon() : Participante
    + getPremio() : double
  }

  class TablaPosiciones <<Iterable<FilaTabla>>> {
    - filas : List<FilaTabla>
    + TablaPosiciones(participantes, eventos)
    + iterator() : Iterator<FilaTabla>
  }

  class RankingEmpresas <<Iterable<FilaRanking>>> {
    - filas : List<FilaRanking>
    + RankingEmpresas(participantes, torneos)
    + iterator() : Iterator<FilaRanking>
  }

  class Finanzas {
    - ingresosPorDisciplina : Map<String, Double>
    - premios : List<Premio>
    - totalIngresos : double
    + registrarIngreso(d : Disciplina, monto : double) : void
    + registrarPremio(t : Torneo) : boolean
    + getTotalIngresos() : double
    + getTotalPremios() : double
  }
}

' ============================================================
' Sistema y consola
' ============================================================
package "arena.sistema" {
  class ArenaGT {
    - participantes : Map<String, Participante>
    - torneos : Map<String, Torneo>
    - empresas : Map<String, Empresa>
    - disciplinas : List<Disciplina>
    - finanzas : Finanzas
    + {static} cargarDatosIniciales() : ArenaGT
    + registrarParticipante(codigo, nombre, empresa) : Participante
    + crearTorneo(codigo, nombre, disciplina) : Torneo
    + cotizar(disciplina : String, cantidad : int) : double
    + inscribir(torneo : String, participante : String) : double
    + cerrarInscripciones(torneo : String) : void
    + programarEvento(evento, fecha, hora, sede) : void
    + registrarResultado(evento : String, entrada : Entrada) : Resultado
    + calendarioGeneral() : Calendario
    + calendarioTorneo(codigo : String) : Calendario
    + calendarioParticipante(codigo : String) : Calendario
    + getRankingEmpresas() : RankingEmpresas
  }

  class EntradaGuion {
    - respuestas : Deque<String>
    + leerTexto(mensaje : String) : String
    + leerEntero(mensaje : String) : int
  }
}

package "arena.ui" {
  class Menu {
    - sistema : ArenaGT
    - entrada : Entrada
    + ejecutar() : void
  }

  class Consola {
    - scanner : Scanner
    + leerTexto(mensaje : String) : String
    + leerEntero(mensaje : String) : int
    + leerDecimal(mensaje : String) : double
  }
}

class Principal {
  + {static} main(args : String[]) : void
}

class PruebasArenaGT {
  + {static} main(args : String[]) : void
}

' ============================================================
' Relaciones
' ============================================================
Disciplina <|-- DisciplinaEncuentro
Disciplina <|-- DisciplinaCarrera
DisciplinaEncuentro <|-- FutbolSala
FutbolSala <|-- FutbolSalaPenales
DisciplinaEncuentro <|-- Baloncesto
DisciplinaEncuentro <|-- Voleibol
DisciplinaCarrera <|-- Relevos

Evento <|-- Encuentro
Evento <|-- Carrera
Evento ..|> Comparable
Evento --> EstadoEvento
Evento --> Resultado
Evento --> Torneo
Encuentro --> DisciplinaEncuentro
Carrera --> DisciplinaCarrera

Resultado <|.. ResultadoEncuentro
Resultado <|.. ResultadoCarrera
ResultadoEncuentro --> Participante
ResultadoCarrera --> Participante

Torneo *-- Evento
Torneo o-- Participante
Torneo --> Disciplina
Torneo --> EstadoTorneo
Torneo o-- TablaPosiciones
Participante --> Empresa

TablaPosiciones ..|> Iterable
RankingEmpresas ..|> Iterable
Calendario ..|> Iterable
TablaPosiciones *-- FilaTabla
RankingEmpresas *-- FilaRanking
Calendario --> Evento
FilaTabla ..|> Comparable
FilaRanking ..|> Comparable

ArenaGT o-- Participante
ArenaGT o-- Torneo
ArenaGT o-- Empresa
ArenaGT o-- Disciplina
ArenaGT *-- Finanzas
ArenaGT ..> RankingEmpresas
ArenaGT ..> Calendario
ArenaGT ..> TablaPosiciones
Menu --> ArenaGT
Menu --> Entrada
Consola ..|> Entrada
EntradaGuion ..|> Entrada
Principal --> ArenaGT
Principal --> Menu
PruebasArenaGT ..> ArenaGT
PruebasArenaGT ..> EntradaGuion

note right of Calendario
  El orden cronológico (fecha, hora
  y nombre de sede) se resuelve en
  Evento.compareTo; el calendario
  solo recorre eventos ya ordenados.
end note

note right of Disciplina
  Cada subclase decide cupos, cuota,
  validación del resultado, puntos
  de tabla y diferencia. El resto
  del sistema no verifica tipos.
end note

note bottom of ArenaGT
  Única clase que conoce todos los
  torneos: valida sede y participante
  ocupados, y registra ingresos solo
  por inscripciones efectivas.
end note

note bottom of Torneo
  Pasa a EN_JUEGO al cerrar inscripciones
  y a FINALIZADO automáticamente cuando
  todos sus eventos tienen resultado.
end note

@enduml
